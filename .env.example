# Flask
FLASK_SECRET="change_me_to_a_random_secret"
FLASK_ENV="development"
FLASK_DEBUG=0
PORT=5000

# First admin user (created automatically on startup if not exists)
ADMIN_PRENOM="admin"
ADMIN_PASS="your_password"

# TMDB API (optional, for TMDB import feature)
# TMDB_API_KEY="your_tmdb_api_key"

# Database (SQLite default, set to PostgreSQL URI for production)
DATABASE_URL="sqlite:///trixifilms.db"
