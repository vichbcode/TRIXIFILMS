# Flask
FLASK_SECRET="change_me_to_a_random_secret"
FLASK_ENV="development"
FLASK_DEBUG=0
PORT=5000

# First admin user (created automatically on startup if not exists)
ADMIN_PRENOM="admin"
ADMIN_PASS="your_password"

# TMDB API (optional, for TMDB import feature)
# TMDB_API_KEY="your_tmdb_api_key"

# Cloudinary (obligatoire pour le stockage des images)
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"
# CLOUDINARY_FOLDER="trixifilms"

# OMDB API (optional, free key at https://www.omdbapi.com/apikey.aspx — 1000 req/day)
# OMDB_API_KEY="your_omdb_api_key"

# JWT signing secret for the mobile API (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# JWT_SECRET="your_long_random_secret"

# Database (PostgreSQL en production, SQLite par défaut en local)
# Format PostgreSQL : postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL="postgresql+psycopg2://postgres:secret@localhost:5432/trixifilms"
DATABASE_URL="sqlite:///trixifilms.db"
